# UniFleet Configuration
PROJECT_NAME="UniFleet Intelligent AGV/AMR Fleet Manager"
API_V1_STR="/api/v1"
SECRET_KEY="unifleet_hackathon_super_secret_key_2026"

# Database Configuration (PostgreSQL primary, SQLite resilience fallback)
POSTGRES_USER=unifleet
POSTGRES_PASSWORD=unifleet_secret_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=unifleet_db
DATABASE_URL=postgresql+asyncpg://unifleet:unifleet_secret_pass@localhost:5432/unifleet_db
FALLBACK_DATABASE_URL=sqlite+aiosqlite:///./unifleet_fallback.db

# MQTT Configuration (Mosquitto primary, embedded loop fallback)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=unifleet_brain_core

# Backend & WebSocket Server
HOST=0.0.0.0
PORT=8000
WEBSOCKET_BROADCAST_INTERVAL_MS=250

# Fleet & Topology Settings
NUM_SIMULATED_ROBOTS=5
DEFAULT_BATTERY_CONSUMPTION_RATE=0.05
LOW_BATTERY_THRESHOLD=20.0
